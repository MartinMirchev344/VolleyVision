# Docker Compose reads .env. Python/Alembic read exported environment variables.
POSTGRES_USER=volleyvision
POSTGRES_DB=volleyvision
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://volleyvision:replace-with-a-local-password@127.0.0.1:5432/volleyvision
VOLLEYVISION_STORAGE_ROOT=./data/media
# Set only to a disposable, dedicated integration test database.
TEST_DATABASE_URL=
